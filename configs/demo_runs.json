{
  "description": "Reduced-size version of every experiment: about ten minutes on a CPU in total. The numbers are noisy and are not those of the paper; the runs show that every entry point works and what it prints.",
  "runs": [
    {"experiment": "closed_form_checks", "device": "cpu", "arguments": "--num-units 3 --num-matrices 5",
     "outputs": ["linear_dynamics/closed_forms.json"]},
    {"experiment": "snap1_exact_instability", "device": "cpu", "arguments": "",
     "outputs": ["linear_dynamics/snap1_exact_instability.json"]},
    {"experiment": "stationary_risk", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 3 --moment-steps 3000 --learning-steps 4000 --families normal@0.9,schur:1.0@0.9",
     "outputs": ["calibrated_point/stationary_risk/tanh_n4_normal_g0.9.json", "calibrated_point/stationary_risk/tanh_n4_schur1.0_g0.9.json"]},
    {"experiment": "stationary_risk", "device": "cpu",
     "arguments": "--cell gru_reset_after --preconditioner identity --step-size 0.02 --num-units 4 --num-systems 2 --moment-steps 2000 --learning-steps 3000 --families random@0.9",
     "outputs": ["calibrated_point/stationary_risk/gru_reset_after_n4_random_g0.9_identity.json"]},
    {"experiment": "efficiency_constant", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 2 --num-replicas 4 --moment-steps 2000 --learning-steps 3000 --step-size 0.002 --noise-std 0.03 --families normal@0.9",
     "outputs": ["calibrated_point/efficiency_constant/tanh_normal_g0.9.json"]},
    {"experiment": "readout_rank", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 3 --num-readout 4,2 --moment-steps 2000 --learning-steps 4000 --evaluation-steps 2000",
     "outputs": ["relevance/readout_rank/tanh_random_g0.8_units_m4.json", "relevance/readout_rank/tanh_random_g0.8_units_m2.json"]},
    {"experiment": "displacement", "device": "cpu",
     "arguments": "--teacher-units 6 --student-units 3 --num-systems 2 --couplings 0.2 --learning-steps 4000 --moment-steps 3000 --evaluation-steps 3000",
     "outputs": ["misspecification/displacement/coupling_0.2.json"]},
    {"experiment": "stability_threshold", "device": "cpu",
     "arguments": "--systems 33:2 --num-steps 6000 --num-replicas 3",
     "outputs": ["restoration/stability_threshold/system_33_2.0.json"]},
    {"experiment": "exchange_rate", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 2 --num-tangents 1,4 --tracking-rates 0.2 --windows 50 --num-windows 200 --bias-field-steps 3000",
     "outputs": ["restoration/exchange_rate/n4.json"]},
    {"experiment": "cost_frontier", "device": "cpu",
     "arguments": "--num-units 6 --num-readout 3 --num-systems 2 --learning-steps 3000 --evaluation-steps 2000 --num-tangents 1,4,full --tracking-rates 0.3 --windows 50",
     "outputs": ["restoration/cost_frontier/n6_m3.json"]},
    {"experiment": "step_cost_benchmark", "device": "cpu",
     "arguments": "--num-units 8,16 --steps 20 --threads 1",
     "outputs": ["restoration/step_cost/cost_cpu.json"]},
    {"experiment": "local_regime", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 3 --radii 0.1,0.8 --learning-steps 3000 --evaluation-steps 2000",
     "outputs": ["calibrated_point/local_regime/tanh_n4_units_m4.json"]},
    {"experiment": "online_prediction", "device": "cpu",
     "arguments": "--tasks delay:5,sunspot --num-units 6 --num-seeds 3 --step-sizes 0.003,0.03 --training-steps 1500 --handover-steps 1000 --train-length 600 --eval-length 500",
     "outputs": ["prediction_tasks/tanh_n6_delay5.json", "prediction_tasks/tanh_n6_sunspot.json"]},
    {"experiment": "tracking_lag", "device": "cpu",
     "arguments": "--num-units 4 --num-systems 2 --num-readout 2 --moment-steps 3000 --learning-steps 6000 --step-sizes 0.01 --total-drift 0.2 --noise-std 0.03",
     "outputs": ["nonstationarity/tracking_lag/tanh_n4_random_g0.9_m2.json"]}
  ]
}
